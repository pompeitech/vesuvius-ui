{
  "name": "@pompeitech/vesuvius",
  "private": true,
  "version": "0.0.0",
  "author": "Davide D'Antonio <davide.dantonio1984@gmail.com>",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "storybook": "turbo run storybook --filter=@pompeitech/storybook",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=@pompeitech/vesuvius-ui && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "turbo": "^2.10.12"
  }
}
